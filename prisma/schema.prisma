generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id            Int           @id @default(autoincrement())
  name          String
  code          String?       @unique
  role          UserRole      @default(SALES_EXECUTIVE)
  color         String        @default("#3A6EA5")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  password      String?       @default("Dutch@26")
  opportunities Opportunity[]
  visitReports  VisitReport[]

  @@map("users")
}

model Yacht {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("yachts")
}

model Company {
  id             Int             @id @default(autoincrement())
  name           String
  type           CompanyType?
  classification Classification?
  address        String?         @db.Text
  city           String?
  country        String          @default("UAE")
  phone          String?
  email          String?
  website        String?
  notes          String?         @db.Text
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  contacts       Contact[]
  visitReports   VisitReport[]

  @@map("companies")
}

model Contact {
  id             Int                   @id @default(autoincrement())
  firstName      String
  lastName       String
  title          String?
  companyId      Int?
  email          String?
  phone          String?
  nationality    String?
  responsibility ContactResponsibility @default(NEUTRAL)
  notes          String?               @db.Text
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  company        Company?              @relation(fields: [companyId], references: [id])
  opportunities  Opportunity[]
  visitReports   VisitReport[]

  @@index([companyId], map: "contacts_companyId_fkey")
  @@map("contacts")
}

model Opportunity {
  id             Int               @id @default(autoincrement())
  clientName     String
  yacht          String
  eventTopic     String
  ownerId        Int?
  priority       Priority          @default(WARM)
  phase          PipelinePhase     @default(IDENTIFICATION)
  status         OpportunityStatus @default(OPEN)
  estimatedValue Decimal           @default(0.00) @db.Decimal(15, 2)
  mev            Decimal           @default(0.00) @db.Decimal(15, 2)
  probability    Int               @default(10)
  closeMonth     String?
  closeYear      Int?
  followupDate   DateTime?
  notes          String?           @db.Text
  contactId      Int?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  guestName      String?
  contact        Contact?          @relation(fields: [contactId], references: [id])
  owner          User?             @relation(fields: [ownerId], references: [id])
  visitReports   VisitReport[]

  @@index([contactId], map: "opportunities_contactId_fkey")
  @@index([ownerId], map: "opportunities_ownerId_fkey")
  @@map("opportunities")
}

model VisitReport {
  id            Int          @id @default(autoincrement())
  companyId     Int
  contactId     Int?
  visitDate     DateTime
  visitType     VisitType    @default(IN_PERSON)
  ownerId       Int?
  attendees     String?      @db.Text
  objective     String?
  summary       String?      @db.Text
  outcome       String?      @db.Text
  nextSteps     String?      @db.Text
  followupDate  DateTime?
  sentiment     Sentiment    @default(NEUTRAL)
  budget        Decimal?     @db.Decimal(15, 2)
  competitor    String?
  opportunityId Int?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  company       Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contact       Contact?     @relation(fields: [contactId], references: [id])
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id])
  owner         User?        @relation(fields: [ownerId], references: [id])

  @@index([companyId], map: "visit_reports_companyId_fkey")
  @@index([contactId], map: "visit_reports_contactId_fkey")
  @@index([opportunityId], map: "visit_reports_opportunityId_fkey")
  @@index([ownerId], map: "visit_reports_ownerId_fkey")
  @@map("visit_reports")
}

enum UserRole {
  SALES_EXECUTIVE
  SALES_MANAGER
  ADMIN
  RESERVATION_AGENT
}

enum CompanyType {
  PRIVATE
  DMC
  FREELANCER
  AGENCY
  OTHER
}

enum Classification {
  HS
  S
  HP
  G
}

enum ContactResponsibility {
  DECISION_MAKER
  INFLUENCER
  NEUTRAL
  BLOCKER
}

enum Priority {
  HOT
  WARM
  COLD
}

enum PipelinePhase {
  IDENTIFICATION
  QUALIFICATION
  PROPOSAL
  COMMITMENT
}

enum OpportunityStatus {
  OPEN
  CLOSE_WON
  CLOSE_LOST
}

enum VisitType {
  IN_PERSON
  VIDEO_CALL
  PHONE
  EMAIL
}

enum Sentiment {
  POSITIVE
  NEUTRAL
  NEGATIVE
}
